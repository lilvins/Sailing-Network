{
  "name": "sailing-network",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names server,vite --prefix-colors cyan,yellow \"node server/index.mjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "scrape": "node scripts/scrape-egman.mjs",
    "cards": "node scripts/build-cards.mjs",
    "art": "node scripts/download-art.mjs",
    "server": "node server/index.mjs",
    "seed:cards": "node server/seed-cards.mjs",
    "seed:admin": "node server/seed-admin.mjs",
    "seed:demo": "node server/seed-demo.mjs",
    "seed:meta": "node server/seed-meta-decks.mjs",
    "fetch:meta": "node scripts/fetch-meta-decks.mjs",
    "seed:avatars": "node server/seed-avatars.mjs",
    "db:peek": "node server/peek.mjs",
    "test": "vitest run && node tests/api-test.mjs",
    "test:unit": "vitest run",
    "test:api": "node tests/api-test.mjs",
    "qa:bot": "node scripts/qa-bot.mjs",
    "compile:optcg": "node scripts/compile-optcg.mjs",
    "bench:autosim": "node scripts/bench-autosim.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/sora": "^5.2.8",
    "@fontsource/vt323": "^5.3.0",
    "@libsql/client": "^0.17.3",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.8.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.3",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
