public/cards/*
!public/cards/DON.webp
!public/cards/BACK.webp
!public/cards/BACK-leader.webp
!public/cards/BACK-don.webp

# Local screenshots / scratch from dev tooling
scripts/.shots/
scripts/.qa/

# Personal session reports for Vins (never committed)
_Reports/
# One-off helper to run seed:cards + art from a double click
update-cards.cmd
update-cards.log
