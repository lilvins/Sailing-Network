# Sailing Network — settings of the server (server/config.mjs reads them).
# Copy to .env on the host and fill it in. Never commit the real file.
# In development none of these is needed: `npm run dev` works with the defaults.

# "production" turns on: https-only cookies, the built site served by the API,
# listening on every network interface, and the checks below.
NODE_ENV=production

# REQUIRED in production: signs the session cookie. At least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=

# Port. Most hosts set PORT themselves; SN_API_PORT wins over it if both are set.
# PORT=8787
# SN_API_PORT=

# Address to listen on. Default: 0.0.0.0 in production, 127.0.0.1 in development.
# SN_HOST=0.0.0.0

# Where the SQLite database file lives. Put it on a disk that survives redeploys.
SN_DB_PATH=/data/sailing.db

# Card images (public/cards, 638 MB, not in git). Copy them to the server's disk
# and name the folder here; without it only the images inside the build are served.
# SN_CARDS_DIR=/data/cards

# The built site. Default: dist. "off" = API only (the site is hosted elsewhere).
# SN_STATIC_DIR=dist

# Other sites allowed to call the API with the login cookie, comma separated,
# written exactly as the browser sends them (https://example.com). Empty = none:
# right when this server serves the site itself.
# CORS_ORIGINS=

# Behind the host's proxy / load balancer (almost always): how many proxies sit
# in front, so each visitor gets their own rate limit. 1 for a single proxy.
TRUST_PROXY=1

# First admin account, read once by `npm run seed:admin`.
# ADMIN_EMAIL=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Set to 1 to stop the matchmaking timer (tests).
# MATCHMAKING_OFF=
